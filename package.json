{
  "name": "texto",
  "publisher": "asiermarques",
  "displayName": "Texto",
  "description": "A minimalist writing editor for markdown, inside VSCode.",
  "version": "0.1.5",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/asiermarques/texto.git"
  },
  "keywords": [
    "markdown",
    "writing",
    "minimalist",
    "editor"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Notebooks",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "customEditors": [
      {
        "viewType": "texto.editor",
        "displayName": "%writing-editor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "texto.toggleFocusMode",
        "title": "%command.toggleFocusMode.title%"
      },
      {
        "command": "texto.increaseTextSize",
        "title": "%command.increaseTextSize.title%"
      },
      {
        "command": "texto.decreaseTextSize",
        "title": "%command.decreaseTextSize.title%"
      },
      {
        "command": "texto.resetTextSize",
        "title": "%command.resetTextSize.title%"
      },
      {
        "command": "texto.toggleRawMarkdown",
        "title": "%command.toggleRawMarkdown.title%"
      },
      {
        "command": "texto.toggleFrontmatter",
        "title": "%command.toggleFrontmatter.title%"
      },
      {
        "command": "texto.showVersion",
        "title": "%command.showVersion.title%"
      },
      {
        "command": "texto.openWithTexto",
        "title": "%command.openWithTexto.title%"
      },
      {
        "command": "texto.openAsMarkdown",
        "title": "%command.openAsMarkdown.title%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "texto.openWithTexto",
          "when": "resourceExtname == .md",
          "group": "navigation"
        },
        {
          "command": "texto.openAsMarkdown",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "texto.openWithTexto",
          "when": "resourceExtname == .md",
          "group": "navigation"
        },
        {
          "command": "texto.openAsMarkdown",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "texto.focusMode": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "%configuration.focusMode.description%"
        },
        "texto.theme": {
          "scope": "resource",
          "type": "string",
          "enum": ["light", "dark", "vscode"],
          "enumDescriptions": [
            "%configuration.theme.enumDescriptions.light%",
            "%configuration.theme.enumDescriptions.dark%",
            "%configuration.theme.enumDescriptions.vscode%"
          ],
          "default": "light",
          "description": "%configuration.theme.description%"
        },
        "texto.textSize": {
          "scope": "resource",
          "type": "number",
          "minimum": 14,
          "maximum": 28,
          "default": 18,
          "description": "%configuration.textSize.description%"
        },
        "texto.alignment": {
          "scope": "resource",
          "type": "string",
          "enum": ["left", "right", "justified"],
          "enumDescriptions": [
            "%configuration.alignment.enumDescriptions.left%",
            "%configuration.alignment.enumDescriptions.right%",
            "%configuration.alignment.enumDescriptions.justified%"
          ],
          "default": "left",
          "description": "%configuration.alignment.description%"
        }
      }
    }
  },
  "scripts": {
    "postinstall": "node ./scripts/enableHooks.js",
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "pretest:performance": "npm run build",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "prereport:performance": "npm run build && npm run compile:test",
    "report:performance": "node ./out/test/performance/report.js",
    "pretest:integration": "npm run build && npm run compile:test",
    "compile:test": "tsc -p tsconfig.test.json",
    "test:integration": "node ./out/test/integration/runTest.js",
    "test": "npm run test:unit && npm run test:performance && npm run test:integration"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.0",
    "esbuild": "^0.23.0",
    "mocha": "^10.7.0",
    "ovsx": "^0.10.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.28.0",
    "@fontsource-variable/literata": "^5.1.0",
    "@lezer/markdown": "^1.7.2",
    "beautiful-mermaid": "^1.1.3"
  }
}

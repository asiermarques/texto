{
  "name": "texto",
  "publisher": "asiermarques",
  "displayName": "Texto",
  "description": "Editor de escritura de prosa markdown, dentro de VSCode.",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "texto.editorDeEscritura",
        "displayName": "Editor de escritura",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "texto.toggleFocusMode",
        "title": "Texto: Alternar modo foco"
      }
    ],
    "configuration": {
      "title": "Texto",
      "properties": {
        "texto.modoFoco": {
          "type": "boolean",
          "default": true,
          "description": "Atenúa todo el Capítulo salvo el bloque que contiene el cursor."
        },
        "texto.tema": {
          "type": "string",
          "enum": ["claro", "oscuro", "vscode"],
          "enumDescriptions": [
            "Fondo de papel, tinta oscura. Ajeno al tema de VSCode.",
            "Fondo oscuro, tinta clara. Ajeno al tema de VSCode.",
            "Sigue el tema activo de VSCode, como en versiones anteriores."
          ],
          "default": "claro",
          "description": "Tema del Editor de escritura."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "pretest:integration": "npm run build && npm run compile:test",
    "compile:test": "tsc -p tsconfig.test.json",
    "test:integration": "node ./out/test/integration/runTest.js",
    "test": "npm run test:unit && npm run test:integration"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.23.0",
    "mocha": "^10.7.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.28.0",
    "@fontsource-variable/literata": "^5.1.0"
  }
}
